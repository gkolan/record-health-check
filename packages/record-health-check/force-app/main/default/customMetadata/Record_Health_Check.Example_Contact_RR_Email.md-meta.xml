<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Contact Readiness - Email</label><protected
  >false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Contact_Relationship_Readiness</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Email Channel Has No Standard Suppression</value></values>
    <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >A usable business email requires an address with no recorded bounce and no standard Email Opt Out flag.</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >QUERY</value></values>
    <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() usableEmails FROM Contact WHERE Id = {!record.Id} AND Email != null AND EmailBouncedDate = null AND HasOptedOutOfEmail = false</value></values>
    <values><field>SourceQueryField__c</field><value
      xsi:type="xsd:string"
    >usableEmails</value></values>
    <values><field>ExpectedValueSource__c</field><value
      xsi:type="xsd:string"
    >FIXED_VALUE</value></values>
    <values><field>ExpectedFixedValue__c</field><value
      xsi:type="xsd:string"
    >1</value></values>
    <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >EQUALS</value></values>
    <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
    <values><field>NoRowsResult__c</field><value
      xsi:type="xsd:string"
    >FAIL</value></values>
    <values><field>EmptyValueHandling__c</field><value
      xsi:type="xsd:string"
    >AS_NO_MATCH</value></values>
    <values><field>DisplayFoundText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.foundValue} usable email channel</value></values>
    <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >1 address without a recorded bounce or standard Email Opt Out</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >{!record.Name fallback="This contact"} has no email channel available under the standard Email, Email Bounced, and Email Opt Out fields.</value></values>
    <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Verify the address and bounce details. Respect Email Opt Out; use your organization's consent process before changing any communication preference.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Review email status</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Contact/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Email-channel readiness could not be evaluated. Verify Email, Email Bounced Date, and Email Opt Out access, then retry.</value></values>
    <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
    <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >10</value></values>
    <values><field>MaxQueryRows__c</field><value
      xsi:type="xsd:double"
    >1</value></values>
    <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
