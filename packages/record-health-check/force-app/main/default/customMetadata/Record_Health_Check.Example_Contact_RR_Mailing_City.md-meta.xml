>
    <label>Example: Contact Readiness - City</label><protected>false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Contact_Relationship_Readiness</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Business Location Has Regional Context</value></values>
    <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >A city plus state or country gives enough context for regional planning without assuming the Account headquarters is the Contact's location.</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >FORMULA</value></values>
    <values><field>PassConditionFormula__c</field><value
      xsi:type="xsd:string"
    >AND(NOT(ISBLANK(MailingCity)), OR(NOT(ISBLANK(MailingState)), NOT(ISBLANK(MailingCountry))))</value></values>
    <values><field>DisplayFoundFormula__c</field><value
      xsi:type="xsd:string"
    >BLANKVALUE(MailingCity, "Business location unknown")</value></values>
    <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >City and state/country</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >INFO</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >Regional planning is incomplete because {!record.Name fallback="this contact"}'s city lacks state or country context.</value></values>
    <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Confirm the Contact's current city and either state or country; do not copy the Account headquarters without verification.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Set {!record.Name fallback="contact"}'s business location</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Contact/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Business location could not be evaluated. Verify Mailing City, State, and Country access, then retry.</value></values>
    <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
    <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >30</value></values>
    <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
