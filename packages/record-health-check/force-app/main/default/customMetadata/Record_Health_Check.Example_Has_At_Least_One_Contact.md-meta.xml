<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Decision Maker roles</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Check_Builder_Guide</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">100</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value
      xsi:type="xsd:string"
    >Open Opportunities include a Decision Maker</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM OpportunityContactRole WHERE Opportunity.AccountId = {!record.Id} AND Opportunity.IsClosed = false AND Role = 'Decision Maker'</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN_OR_EQUAL</value>
    </values>
    <values>
        <field>ExpectedValueSource__c</field>
        <value xsi:type="xsd:string">FIXED_VALUE</value>
    </values>
    <values>
        <field>ExpectedFixedValue__c</field>
        <value xsi:type="xsd:string">1</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">ALL_RECORDS</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">WARNING</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >No decision-maker Contact Role is identified across the open pipeline for {!record.Name fallback="this Account"}.</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcCheck.checkTitle fallback="This check"} could not run for {!record.Name fallback="this Account"}. Review the check setup and the running user's access, then try again.</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >For {!record.Name fallback="this Account"}, confirm final buying authority, then add the verified Contact as a Decision Maker on the appropriate open Opportunity. Do not infer authority from title alone.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Review buying roles for {!record.Name fallback="Account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/related/Opportunities/view</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >The Query check counts Decision Maker Contact Roles across open Opportunities. It passes when at least one role exists. This checks the recorded role, not whether the person has verified buying authority.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:nil="true" />
    </values>

    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">NUMBER</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">FAIL</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">SKIP_RECORD</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value xsi:type="xsd:string">{!rhcResult.foundValue}</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value xsi:type="xsd:string">{!rhcResult.expectedValue}</value>
    </values>
</CustomMetadata>
