<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
  <label>Example: Contact - Email or Phone</label><protected>false</protected>
  <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Contact_Relationship_Readiness</value></values>
  <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Contact has Email or Phone</value></values>
  <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >The Formula check passes when Email or Phone has a value. It checks completeness, not reachability or permission to contact.</value></values>
  <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >FORMULA</value></values>
  <values><field>PassConditionFormula__c</field><value
      xsi:type="xsd:string"
    >OR(NOT(ISBLANK(Email)), NOT(ISBLANK(Phone)))</value></values>
  <values><field>DisplayFoundFormula__c</field><value
      xsi:type="xsd:string"
    >IF(NOT(ISBLANK(Email)), "Email recorded", IF(NOT(ISBLANK(Phone)), "Phone recorded", "Neither recorded"))</value></values>
  <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >Email or Phone</value></values>
  <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
  <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >{!record.Name fallback="This Contact"} has neither Email nor Phone.</value></values>
  <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Add the appropriate business contact details. Check communication preferences before contacting this person.</value></values>
  <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Review outreach details</value></values>
  <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Contact/{!record.Id}/edit</value></values>
  <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Contact details could not be evaluated. Verify access to Email and Phone, then retry.</value></values>
  <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
  <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >40</value></values>
  <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
</CustomMetadata>
