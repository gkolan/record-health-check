<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
  <label>Example: Contact - Recent Engagement</label><protected
  >false</protected>
  <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Contact_Relationship_Readiness</value></values>
  <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >A Task was completed in the last 60 days</value></values>
  <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >The Query check passes when at least one completed Task is dated within the last 60 days. It does not assess engagement quality.</value></values>
  <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >QUERY</value></values>
  <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() recentActivities FROM Task WHERE WhoId = {!record.Id} AND IsClosed = true AND ActivityDate = LAST_N_DAYS:60</value></values>
  <values><field>SourceQueryField__c</field><value
      xsi:type="xsd:string"
    >recentActivities</value></values>
  <values><field>ExpectedValueSource__c</field><value
      xsi:type="xsd:string"
    >FIXED_VALUE</value></values>
  <values><field>ExpectedFixedValue__c</field><value
      xsi:type="xsd:string"
    >1</value></values>
  <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >GREATER_THAN_OR_EQUAL</value></values>
  <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
  <values><field>NoRowsResult__c</field><value
      xsi:type="xsd:string"
    >FAIL</value></values>
  <values><field>EmptyValueHandling__c</field><value
      xsi:type="xsd:string"
    >AS_NO_MATCH</value></values>
  <values><field>DisplayFoundText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.foundValue}</value></values>
  <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.expectedValue}</value></values>
  <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
  <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >No completed engagement has been recorded for {!record.Name fallback="this contact"} in the last 60 days.</value></values>
  <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Confirm the relationship status, log a completed interaction when one occurred, or schedule a specific next outreach.</value></values>
  <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Log activity for {!record.Name fallback="contact"}</value></values>
  <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Task/new?defaultFieldValues=WhoId={!record.Id}</value></values>
  <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Recent engagement could not be evaluated. Verify Task access for this Contact and retry.</value></values>
  <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
  <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >80</value></values>
  <values><field>MaxQueryRows__c</field><value
      xsi:type="xsd:double"
    >1</value></values>
  <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
</CustomMetadata>
