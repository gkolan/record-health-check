<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Account Owner Is Active</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Relationship_Risk</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Account owner is active</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Confirms that the account is assigned to an active user who can own follow-up and customer commitments.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() activeOwners FROM User WHERE Id = {!record.OwnerId} AND IsActive = true</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">activeOwners</value>
    </values>
    <values>
        <field>ExpectedValueSource__c</field>
        <value xsi:type="xsd:string">FIXED_VALUE</value>
    </values>
    <values>
        <field>ExpectedFixedValue__c</field>
        <value xsi:type="xsd:string">1</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">EQUALS</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">FAIL</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">AS_NO_MATCH</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value xsi:type="xsd:string">Active User owner count</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value xsi:type="xsd:string">1 active User owner</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This account"} is not assigned to an active User owner, so customer commitments no longer have an accountable owner.</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Ask your Salesforce administrator to confirm the replacement owner, preserve open commitments, and reassign {!record.Name fallback="the account"}.</value>
    </values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Review account ownership</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >{!rhcCheck.checkTitle} could not evaluate the owner of {!record.Name fallback="this account"}. Verify access to the Account owner and User status, then retry.</value></values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">ALL_RECORDS</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">20</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">1</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
</CustomMetadata>
