<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Pipeline creation momentum</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Check_Builder_Guide</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value
      xsi:type="xsd:string"
    >Opportunity creation keeps pace quarter over quarter</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >The Compare Two Queries check passes when Opportunities created this quarter are greater than or equal to the previous quarter.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:nil="true" />
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">COMPARE_TWO_QUERIES</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() currentQuarter FROM Opportunity WHERE AccountId = {!record.Id} AND CreatedDate = THIS_QUARTER</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">currentQuarter</value>
    </values>
    <values>
        <field>ComparisonQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() priorQuarter FROM Opportunity WHERE AccountId = {!record.Id} AND CreatedDate = LAST_QUARTER</value>
    </values>
    <values>
        <field>ComparisonQueryField__c</field>
        <value xsi:type="xsd:string">priorQuarter</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN_OR_EQUAL</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">SKIP_RECORD</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Fewer Opportunities were created this quarter than last quarter for {!record.Name fallback="this Account"}.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcCheck.checkTitle fallback="This check"} could not run for {!record.Name fallback="this Account"}. Review the check setup and the running user's access, then try again.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_COUNT_QUERY_MATCHES</value>
    </values>
    <values>
        <field>ApplicabilityCountQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Opportunity WHERE AccountId = {!record.Id} AND CreatedDate = LAST_QUARTER</value>
    </values>
    <values>
        <field>ApplicabilityCountOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN</value>
    </values>
    <values>
        <field>ApplicabilityCountThreshold__c</field>
        <value xsi:type="xsd:double">0</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">170</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >For {!record.Name fallback="this Account"}, review prospecting and account-plan execution. Create only qualified Opportunities and adapt for seasonality.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Review pipeline for {!record.Name fallback="Account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/related/Opportunities/view</value>
    </values>

    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">NUMBER</value>
    </values>
    <values>
        <field>ApplicabilityNotMetMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This Account"} had no Opportunities created last quarter, so there is no prior-quarter baseline.</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">FAIL</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value
      xsi:type="xsd:string"
    >Opportunities created this quarter: {!rhcResult.foundValue}</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value
      xsi:type="xsd:string"
    >Opportunities created last quarter: {!rhcResult.expectedValue}</value>
    </values>
</CustomMetadata>
