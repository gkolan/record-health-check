<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RunButtonDisplay__c</fullName>
    <label>Run Button Display</label>
    <description
  >Choose how the Run and Rerun buttons appear in the card header. A Check Set that waits for the user must display a button. Hide is available only when checks run automatically when the page opens.</description>
    <inlineHelpText
  >Show a label and icon, label only, or icon only. Hide the buttons only when When Checks Run is set to When the page opens.</inlineHelpText>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>LABEL_AND_ICON</fullName>
                <default>true</default>
                <label>Label and icon</label>
            </value>
            <value>
                <fullName>LABEL_ONLY</fullName>
                <default>false</default>
                <label>Label only</label>
            </value>
            <value>
                <fullName>ICON_ONLY</fullName>
                <default>false</default>
                <label>Icon only</label>
            </value>
            <value>
                <fullName>HIDE</fullName>
                <default>false</default>
                <label>Hide</label>
            </value>
        </valueSetDefinition>
    </valueSet>
    <required>false</required>
</CustomField>
