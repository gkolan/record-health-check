<?xml version="1.0" encoding="UTF-8" ?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description
  >Bounded, expiring verification receipts for inactive Record Health Check drafts. Receipts never store record values or evidence rows.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <externalSharingModel>Private</externalSharingModel>
    <label>Record Health Check Readiness</label>
    <nameField>
        <displayFormat>RHC-R-{000000}</displayFormat>
        <label>Readiness Receipt Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Record Health Check Readiness Receipts</pluralLabel>
    <sharingModel>Private</sharingModel>
</CustomObject>
