  <description
  >Integration persona can read Account, Industry, and Website but not Annual Revenue.</description>
  <hasActivationRequired>false</hasActivationRequired>
  <objectPermissions>
    <allowCreate>false</allowCreate><allowDelete>false</allowDelete><allowEdit
    >false</allowEdit><allowRead>true</allowRead><modifyAllRecords
