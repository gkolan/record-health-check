<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Account Rows ComparisonRows</label>
    <protected>false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Account_Row_Tokens_Positive</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >First and Last Contact Surnames Match</value></values>
    <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >The only shape that produces comparisonRows. Both sides are ungrouped aggregates that return rather than count, so each has one addressable row, needs no ORDER BY, and can be counted honestly.</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >COMPARE_TWO_QUERIES</value></values>
    <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT MIN(LastName) firstSurname FROM Contact WHERE AccountId = {!record.Id}</value></values>
    <values><field>SourceQueryField__c</field><value
      xsi:type="xsd:string"
    >firstSurname</value></values>
    <values><field>ComparisonQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT MAX(LastName) lastSurname FROM Contact WHERE AccountId = {!record.Id}</value></values>
    <values><field>ComparisonQueryField__c</field><value
      xsi:type="xsd:string"
    >lastSurname</value></values>
    <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
    <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >EQUALS</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >Surnames run from {!rhcQuery.sourceRows[1].firstSurname} to {!rhcQuery.comparisonRows[1].lastSurname} ({!rhcQuery.sourceRowCount} source row, {!rhcQuery.comparisonRowCount} comparison row).</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Could not read the contact surnames for this account.</value></values>
    <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >40</value></values>
    <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
    <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
</CustomMetadata>
