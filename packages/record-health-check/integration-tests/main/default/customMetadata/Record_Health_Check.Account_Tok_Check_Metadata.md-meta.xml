<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Account Token - Check Metadata</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Token_Surfaces</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Check Metadata Tokens Render</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Fails on purpose so its failure message renders every rhcCheck token, including the ones no other fixture uses.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">CONSISTENCY</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value xsi:type="xsd:string">ISBLANK(Id)</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">BOOLEAN</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value xsi:type="xsd:string">{!rhcCheck.checkTitle}</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value xsi:type="xsd:string">Every rhcCheck token filled in</value>
    </values>
