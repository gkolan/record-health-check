<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Annual revenue threshold</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Check_Builder_Guide</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value
      xsi:type="xsd:string"
    >Annual revenue is at least $1 million</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >The Formula check compares Annual Revenue with $1,000,000. It passes when Annual Revenue is at least that threshold and fails when it is lower.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:nil="true" />
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value xsi:type="xsd:string">AnnualRevenue &gt;= 1000000</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">WARNING</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This Account"} has Annual Revenue below $1,000,000.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcCheck.checkTitle fallback="This check"} could not run for {!record.Name fallback="this Account"}. Review the check setup and the running user's access, then try again.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">NOT(ISBLANK(AnnualRevenue))</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">10</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >For {!record.Name fallback="this Account"}, confirm Annual Revenue with the Account owner and update it from an approved source. Do not change the value only to pass the Check.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Review Annual Revenue for {!record.Name fallback="Account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value>
    </values>

    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">TEXT</value>
    </values>
    <values>
        <field>ApplicabilityNotMetMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This Account"} has no Annual Revenue, so the threshold cannot be checked.</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>DisplayFoundFormula__c</field>
        <value xsi:type="xsd:string">TEXT(AnnualRevenue)</value>
    </values>
    <values>
        <field>DisplayExpectedFormula__c</field>
        <value xsi:type="xsd:string">"$1,000,000 or more"</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value xsi:type="xsd:string">{!rhcResult.foundValue}</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value xsi:type="xsd:string">{!rhcResult.expectedValue}</value>
    </values>
</CustomMetadata>
