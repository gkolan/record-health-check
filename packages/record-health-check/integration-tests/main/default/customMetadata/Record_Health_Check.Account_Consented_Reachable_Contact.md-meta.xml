<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Compliance - Reachable Contact</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Compliance_Audit</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Has a Consented, Reachable Contact</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Reachability audit: at least one contact has an email address without a recorded bounce. SOQL applicability skips accounts with no contacts.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT Id FROM Contact WHERE AccountId = {!record.Id} AND Email != null AND EmailBouncedDate = null</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">Id</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ANY_ROW_PASSES</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">IS_NOT_BLANK</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">SKIP</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">WARNING</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} has contacts, but none have an email address without a recorded bounce.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not verify contact email reachability. Contact your administrator.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_COUNT_QUERY_MATCHES</value>
    </values>
    <values>
        <field>ApplicabilityCountQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Contact WHERE AccountId = {!record.Id}</value>
    </values>
    <values>
        <field>ApplicabilityCountOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN</value>
    </values>
    <values>
        <field>ApplicabilityCountThreshold__c</field>
        <value xsi:type="xsd:double">0</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">30</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
</CustomMetadata>
