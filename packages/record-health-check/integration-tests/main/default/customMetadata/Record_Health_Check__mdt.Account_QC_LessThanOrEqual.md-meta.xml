        <value xsi:type="xsd:string">Account_Query_Coverage</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Open Case Volume Within Limit</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Less than or equal comparison operator on Verify with a query: open Case COUNT() must be at most 10. Completes the ordered comparison operator matrix alongside Less than and Greater than or equal in this Check Set.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
