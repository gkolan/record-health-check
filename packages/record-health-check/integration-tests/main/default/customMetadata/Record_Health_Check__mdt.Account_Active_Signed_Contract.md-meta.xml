<?xml version='1.0' encoding='UTF-8' ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Compliance - Active Signed Contract</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Compliance_Audit</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Has an Active Signed Contract</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Customer accounts must have an activated, signed, unexpired contract. If Query Finds No Records is set to Fail, so an account with no qualifying contract fails rather than passing quietly.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT Id FROM Contract WHERE AccountId = {!record.Id} AND Status = 'Activated' AND CustomerSignedDate != null AND EndDate &gt;= TODAY</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">Id</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ANY_ROW_PASSES</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">IS_NOT_BLANK</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">FAIL</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} is a customer with no active, signed contract on file. Verify the agreement before continued service or billing.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not verify contracts on this account. Contact your administrator.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">ISPICKVAL(Type, "Customer")</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">40</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
</CustomMetadata>
