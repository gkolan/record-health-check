>
    <label>Example: Contact Readiness - Email</label><protected
  >false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Contact_Relationship_Readiness</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Email Channel Has No Recorded Bounce</value></values>
    <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >The Query check passes when Email is populated and Email Bounced Date is blank. It does not verify delivery or permission to contact.</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >QUERY</value></values>
    <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() usableEmails FROM Contact WHERE Id = {!record.Id} AND Email != null AND EmailBouncedDate = null</value></values>
    <values><field>SourceQueryField__c</field><value
      xsi:type="xsd:string"
    >usableEmails</value></values>
    <values><field>ExpectedValueSource__c</field><value
      xsi:type="xsd:string"
    >FIXED_VALUE</value></values>
    <values><field>ExpectedFixedValue__c</field><value
      xsi:type="xsd:string"
    >1</value></values>
    <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >EQUALS</value></values>
    <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
    <values><field>NoRowsResult__c</field><value
      xsi:type="xsd:string"
    >FAIL</value></values>
    <values><field>EmptyValueHandling__c</field><value
      xsi:type="xsd:string"
    >AS_NO_MATCH</value></values>
    <values><field>DisplayFoundText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.foundValue}</value></values>
    <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.expectedValue}</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >{!record.Name fallback="This contact"} has no email channel available under the standard Email and Email Bounced fields.</value></values>
    <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Verify the address and bounce details, and follow your organization's consent process before contacting this person.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Review email status</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Contact/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
