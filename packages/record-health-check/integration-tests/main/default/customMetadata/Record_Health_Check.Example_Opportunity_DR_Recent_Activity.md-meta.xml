<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
  <label>Example: Deal - Recent Activity</label><protected>false</protected>
  <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Opportunity_Deal_Readiness</value></values>
  <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Deal Engagement Is Current</value></values>
  <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >A completed activity in the last 30 days provides evidence that an open deal is actively progressing.</value></values>
  <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >QUERY</value></values>
  <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() recentActivities FROM Task WHERE WhatId = {!record.Id} AND IsClosed = true AND ActivityDate = LAST_N_DAYS:30</value></values>
  <values><field>SourceQueryField__c</field><value
      xsi:type="xsd:string"
    >recentActivities</value></values>
  <values><field>ExpectedValueSource__c</field><value
      xsi:type="xsd:string"
    >FIXED_VALUE</value></values>
  <values><field>ExpectedFixedValue__c</field><value
      xsi:type="xsd:string"
    >1</value></values>
  <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >GREATER_THAN_OR_EQUAL</value></values>
  <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
  <values><field>NoRowsResult__c</field><value
      xsi:type="xsd:string"
    >FAIL</value></values>
  <values><field>EmptyValueHandling__c</field><value
      xsi:type="xsd:string"
    >AS_NO_MATCH</value></values>
  <values><field>DisplayFoundText__c</field><value
      xsi:type="xsd:string"
    >{!rhcResult.foundValue} completed deal activities in the last 30 days</value></values>
  <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >At least 1 recent completed deal activity</value></values>
  <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
  <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >No completed activity has been recorded for {!record.Name fallback="this opportunity"} in the last 30 days, weakening evidence of deal momentum.</value></values>
  <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Confirm whether the deal is active. Log a completed customer interaction when one occurred, or schedule a concrete next action.</value></values>
  <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Log deal activity</value></values>
  <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Task/new?defaultFieldValues=WhatId={!record.Id}</value></values>
  <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Recent deal activity could not be evaluated. Verify Task access for this Opportunity and retry.</value></values>
  <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >WHEN_FORMULA_TRUE</value></values>
  <values><field>ApplicabilityFormula__c</field><value
      xsi:type="xsd:string"
    >NOT(IsClosed)</value></values>
  <values><field>ApplicabilityNotMetMessage__c</field><value
      xsi:type="xsd:string"
    >The opportunity is closed, so active deal-engagement readiness is not evaluated.</value></values>
  <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >60</value></values>
  <values><field>MaxQueryRows__c</field><value
      xsi:type="xsd:double"
    >1</value></values>
  <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
</CustomMetadata>
