    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">APEX</value>
    </values>
    <values>
        <field>ApexClass__c</field>
        <value xsi:type="xsd:string">AccountStrategicReadinessCheck</value>
    </values>
    <values>
        <field>ApexParametersJson__c</field>
        <value
      xsi:type="xsd:string"
    >{"minScore": 80, "activityDaysBack": 60}</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
