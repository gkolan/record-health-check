<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Subscriber On-Load Compare</label>
    <protected>false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Release_On_Load</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Contacts do not exceed total opportunities</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >COMPARE_TWO_QUERIES</value></values>
    <values><field>SourceQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Contact WHERE AccountId = {!record.Id}</value></values>
    <values><field>ComparisonQuery__c</field><value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Opportunity WHERE AccountId = {!record.Id}</value></values>
    <values><field>QueryResultHandling__c</field><value
      xsi:type="xsd:string"
    >ONE_RESULT</value></values>
    <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >LESS_THAN_OR_EQUAL</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >INFO</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >The Account has more contacts than opportunities.</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >The installed-package on-load comparison could not be evaluated.</value></values>
    <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
    <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >30</value></values>
    <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >The Compare Two Queries leg of the on-load matrix. Passes when contacts do not outnumber total opportunities, proving a two-query comparison runs on load.</value>
    </values>
    <values>
        <field>ComparisonDisplayMode__c</field>
        <value xsi:type="xsd:string">AUTOMATIC</value>
    </values>
    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">AS_NO_MATCH</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
</CustomMetadata>
