<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Compliance - High Risk Reviewed</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Compliance_Audit</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value
      xsi:type="xsd:string"
    >High-Risk Account Reviewed in Last 12 Months</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >AML periodic review: high-risk accounts need Last_Compliance_Review_Date__c within 365 days. Custom fields: replace with your org's risk model.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value
      xsi:type="xsd:string"
    >AND(NOT(ISBLANK(Last_Compliance_Review_Date__c)), (TODAY() - Last_Compliance_Review_Date__c) &lt; 365)</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} is high-risk and has not had a compliance review in over 12 months. Schedule a review now.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not evaluate compliance review date: confirm custom risk fields exist. Contact your administrator.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">ISPICKVAL(Risk_Rating__c, "High")</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">70</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Carry out the annual review for this high-risk account and record the review date. A lapsed review is itself an audit finding.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Edit {!record.Name fallback="account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">RISK</value>
    </values>
    <values>
        <field>ComparisonDisplayMode__c</field>
        <value xsi:type="xsd:string">AUTOMATIC</value>
    </values>
    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">AS_NO_MATCH</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
</CustomMetadata>
