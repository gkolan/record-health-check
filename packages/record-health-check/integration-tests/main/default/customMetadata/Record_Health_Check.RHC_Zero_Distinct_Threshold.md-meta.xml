    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >COUNT_DISTINCT in a single-query Check with a fixed Expected value of 1. An Account with no Contacts has 0 cities and fails.</value>
