<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Compliance - KYC Verified</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Compliance_Audit</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">KYC Verification Complete</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >KYC/AML: customer accounts must have KYC_Status__c = Verified. Replace with your org's custom field and picklist values.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value
      xsi:type="xsd:string"
    >ISPICKVAL(KYC_Status__c, "Verified")</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} is an active customer without completed KYC verification. Block further activity until identity is verified.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not evaluate KYC status: confirm KYC_Status__c exists. Contact your administrator.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">ISPICKVAL(Type, "Customer")</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">60</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Complete know-your-customer verification and record the outcome before any financial transaction proceeds.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Edit {!record.Name fallback="account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">COMPLIANCE</value>
    </values>
    <values>
        <field>ComparisonDisplayMode__c</field>
        <value xsi:type="xsd:string">AUTOMATIC</value>
    </values>
    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">AS_NO_MATCH</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
</CustomMetadata>
