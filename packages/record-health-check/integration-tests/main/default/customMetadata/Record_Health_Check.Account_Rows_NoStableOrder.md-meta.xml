    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >INFO</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >This Check is misconfigured and was not evaluated.</value></values>
