<?xml version='1.0' encoding='UTF-8' ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Compliance - Country Not Restricted</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Account_Compliance_Audit</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Billing Country Not Restricted</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Sanctions screening: BillingCountry must not appear in Restricted_Country__c reference list. Requires custom object Restricted_Country__c with Name and Active__c.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>FindInListFormula__c</field>
        <value xsi:type="xsd:string">BillingCountry</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">COMPARE_AS_LISTS</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">LIST_CONTAINS_NONE</value>
    </values>
    <values>
        <field>ComparisonQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT Name FROM Restricted_Country__c WHERE Active__c = true</value>
    </values>
    <values>
        <field>ComparisonQueryField__c</field>
        <value xsi:type="xsd:string">Name</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">PASS</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} has a billing country on the restricted/sanctioned list. Do not transact until compliance clears this account.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not screen billing country: confirm Restricted_Country__c exists. Contact your administrator.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">NOT(ISBLANK(BillingCountry))</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">80</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
