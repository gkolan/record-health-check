    <values><field>ComparisonOperator__c</field><value
      xsi:type="xsd:string"
    >IS_NOT_BLANK</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >Open the first contact to add an address.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >View {!rhcQuery.sourceRows[0].LastName fallback="the contact"}</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
