<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Pipeline Covers Annual Rev</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Compare_Two_Queries</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">20</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Open Pipeline Covers Annual Revenue</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">COMPARE_TWO_QUERIES</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT SUM(Amount) pipelineTotal FROM Opportunity WHERE AccountId = {!record.Id} AND IsClosed = false AND Amount != null</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">pipelineTotal</value>
    </values>
    <values>
        <field>ComparisonQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT AnnualRevenue FROM Account WHERE Id = {!record.Id} LIMIT 1</value>
    </values>
    <values>
        <field>ComparisonQueryField__c</field>
        <value xsi:type="xsd:string">AnnualRevenue</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN_OR_EQUAL</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_COUNT_QUERY_MATCHES</value>
    </values>
    <values>
        <field>ApplicabilityCountQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Opportunity WHERE AccountId = {!record.Id} AND IsClosed = false AND Amount != null</value>
    </values>
    <values>
        <field>ApplicabilityCountOperator__c</field>
        <value xsi:type="xsd:string">GREATER_THAN</value>
    </values>
    <values>
        <field>ApplicabilityCountThreshold__c</field>
        <value xsi:type="xsd:string">0</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">WARNING</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Total open pipeline is below Annual Revenue.</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >A Compare Two Queries check comparing an aggregate against a field. Passes when the open pipeline total is at least the account's annual revenue.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Could not evaluate this Check for {!record.Name}. Confirm the running user can read Opportunities related to this account, and read Annual Revenue on the account and the fields this Check selects, then run the Check again.</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Build pipeline until it covers the revenue base, or accept that this account is in decline and plan for it.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Review opportunities on {!record.Name fallback="this account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/related/Opportunities/view</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">RISK</value>
    </values>
    <values>
        <field>ComparisonDisplayMode__c</field>
        <value xsi:type="xsd:string">AUTOMATIC</value>
    </values>
    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">AS_NO_MATCH</value>
    </values>
    <values>
        <field>FormulaResultType__c</field>
        <value xsi:type="xsd:string">AUTO</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
</CustomMetadata>
