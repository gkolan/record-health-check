>
    <label>Zero: emails cover contacts</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">RHC_Zero_Aggregate</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Every Contact has an Email</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >COUNT(Email) on the comparison side of Compare two queries. An Account with no Contacts compares 0 Contacts with 0 Emails and passes.</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">COMPARE_TWO_QUERIES</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Contact WHERE AccountId = {!record.Id}</value>
    </values>
    <values>
        <field>ComparisonQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT(Email) withEmail FROM Contact WHERE AccountId = {!record.Id}</value>
    </values>
    <values>
        <field>ComparisonQueryField__c</field>
        <value xsi:type="xsd:string">withEmail</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">EQUALS</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name} has Contacts without an Email.</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">20</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
