<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Reachable deal stakeholders</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Check_Builder_Guide</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">110</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value
      xsi:type="xsd:string"
    >Open-deal stakeholders have a verified contact channel</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() unreachableStakeholders FROM OpportunityContactRole WHERE Opportunity.AccountId = {!record.Id} AND Opportunity.IsClosed = false AND ContactId != null AND Contact.Email = null AND Contact.Phone = null</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">EQUALS</value>
    </values>
    <values>
        <field>ExpectedValueSource__c</field>
        <value xsi:type="xsd:string">FIXED_VALUE</value>
    </values>
    <values>
        <field>ExpectedFixedValue__c</field>
        <value xsi:type="xsd:string">0</value>
    </values>
    <values>
        <field>NoRowsResult__c</field>
        <value xsi:type="xsd:string">PASS</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">ALL_RECORDS</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">WARNING</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >One or more open-deal stakeholders for {!record.Name fallback="this Account"} have neither email nor phone.</value>
    </values>
    <values>
        <field>SourceQueryField__c</field>
        <value xsi:type="xsd:string">unreachableStakeholders</value>
    </values>
    <values>
        <field>PublishUserResultEvent__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcCheck.checkTitle fallback="This check"} could not run for {!record.Name fallback="this Account"}. Review the check setup and the running user's access, then try again.</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >For {!record.Name fallback="this Account"}, confirm a permitted email address or phone number directly with the stakeholder or an authorized source. Never add fabricated contact data.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Review buying contacts for {!record.Name fallback="Account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/related/Opportunities/view</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >The Query check passes when no Contact attached to an open Opportunity lacks both email and phone, connecting buying-committee coverage to usable outreach evidence.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:nil="true" />
    </values>

    <values>
        <field>DisplayValueFormat__c</field>
        <value xsi:type="xsd:string">NUMBER</value>
    </values>
    <values>
        <field>MaxQueryRows__c</field>
        <value xsi:type="xsd:double">200</value>
    </values>
    <values>
        <field>EmptyValueHandling__c</field>
        <value xsi:type="xsd:string">SKIP_RECORD</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value
      xsi:type="xsd:string"
    >Open-deal stakeholders without email or phone: {!rhcResult.foundValue}</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value
      xsi:type="xsd:string"
    >Buyer-contact standard: {!rhcResult.expectedValue} unreachable stakeholders</value>
    </values>
</CustomMetadata>
