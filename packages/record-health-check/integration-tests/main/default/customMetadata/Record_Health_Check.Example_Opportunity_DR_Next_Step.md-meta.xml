<?xml version="1.0" encoding="UTF-8" ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example: Deal Readiness - Next Step</label><protected
  >false</protected>
    <values><field>Record_Health_Check_Set__c</field><value
      xsi:type="xsd:string"
    >Example_Opportunity_Deal_Readiness</value></values>
    <values><field>CheckTitle__c</field><value
      xsi:type="xsd:string"
    >Next Step has non-placeholder text</value></values>
    <values><field>CheckDescription__c</field><value
      xsi:type="xsd:string"
    >The Formula check passes for closed deals, or when an open deal has Next Step text other than TBD, N/A, NA, or a dash. It does not verify an owner, action, or timing.</value></values>
    <values><field>EvaluationType__c</field><value
      xsi:type="xsd:string"
    >FORMULA</value></values>
    <values><field>PassConditionFormula__c</field><value
      xsi:type="xsd:string"
    >OR(IsClosed, AND(NOT(ISBLANK(NextStep)), NOT(OR(LOWER(TRIM(NextStep)) = "tbd", LOWER(TRIM(NextStep)) = "n/a", LOWER(TRIM(NextStep)) = "na", TRIM(NextStep) = "-"))))</value></values>
    <values><field>DisplayFoundFormula__c</field><value
      xsi:type="xsd:string"
    >IF(IsClosed, "Deal is closed", BLANKVALUE(NextStep, "No next step documented"))</value></values>
    <values><field>DisplayExpectedText__c</field><value
      xsi:type="xsd:string"
    >Non-placeholder text; closed exempt</value></values>
    <values><field>FailureSeverity__c</field><value
      xsi:type="xsd:string"
    >WARNING</value></values>
    <values><field>FailureMessage__c</field><value
      xsi:type="xsd:string"
    >{!record.Name fallback="This opportunity"}'s next step is blank or uses a common placeholder instead of the next task needed to progress the deal.</value></values>
    <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Replace the placeholder with the agreed next task, owner, and timing used by your sales process.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Plan {!record.Name fallback="opportunity"}'s next move</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Opportunity/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >Deal momentum could not be evaluated for {!record.Name fallback="this opportunity"}. Verify Next Step access and retry.</value></values>
    <values><field>ApplicabilityMode__c</field><value
      xsi:type="xsd:string"
    >ALL_RECORDS</value></values>
    <values><field>EvaluationOrder__c</field><value
      xsi:type="xsd:double"
    >40</value></values>
    <values><field>IsActive__c</field><value
      xsi:type="xsd:boolean"
    >true</value></values>
</CustomMetadata>
