    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Let the source be set by the originating process rather than by hand, so attribution reporting stays trustworthy.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Edit {!record.Name fallback="account"}</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">CONSISTENCY</value>
    </values>
