NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ALLOWED_HOSTS=mcp.example.com
ALLOWED_ORIGINS=mcp.example.com
AUTH_MODE=jwt
MCP_SERVER_URL=https://mcp.example.com/mcp
MCP_AUTH_ISSUER=https://identity.example.com
MCP_AUTH_AUDIENCE=record-health-check
MCP_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
MCP_AUTH_REQUIRED_SCOPE=rhc.run
SALESFORCE_LOGIN_URL=https://example.my.salesforce.com
SALESFORCE_CLIENT_ID=replace-at-runtime
SALESFORCE_CLIENT_SECRET=replace-at-runtime
SALESFORCE_ALLOWED_HOSTS=example.my.salesforce.com
SALESFORCE_REST_PATH=/services/apexrest/rhc/record-health-check/contract-1/evaluations
SALESFORCE_TIMEOUT_MS=10000
SALESFORCE_MAX_RESPONSE_BYTES=65536
SALESFORCE_MAX_RETRIES=1
MAX_CONCURRENT_SALESFORCE_CALLS=10
KILL_SWITCH=false
BUILD_ID=local
