{
  "name": "@record-health-check/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Hosted MCP tools for the Record Health Check Salesforce package",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "contract:org": "npm run build && node ../../scripts/release/verify_mcp_salesforce_contract.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{json,md,yaml,yml}\"",
    "lint": "eslint src test",
    "start": "node dist/main.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.1",
    "prettier": "^3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "4.1.10"
  }
}
