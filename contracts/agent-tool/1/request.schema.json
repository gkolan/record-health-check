{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gkolan.github.io/record-health-check/contracts/agent-tool/1/request.schema.json",
  "title": "Record Health Check agent tool request contract 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "recordId", "qualifiedApiName"],
  "properties": {
    "operation": { "enum": ["RUN_CHECK", "RUN_CHECK_SET"] },
    "recordId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9]{15}(?:[a-zA-Z0-9]{3})?$"
    },
    "qualifiedApiName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-zA-Z][a-zA-Z0-9_]*(?:__[a-zA-Z][a-zA-Z0-9_]*)?$"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    }
  }
}
