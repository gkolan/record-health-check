<?xml version='1.0' encoding='UTF-8' ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example_No High-Priority Customer Issues</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Relationship_Risk</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">No high-priority customer issues</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Confirms that no unresolved high-priority support issues are putting the customer relationship at risk.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">READINESS</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">QUERY</value>
    </values>
    <values>
        <field>SourceQuery__c</field>
        <value
      xsi:type="xsd:string"
    >SELECT COUNT() FROM Case WHERE AccountId = {!record.Id} AND IsClosed = false AND Priority = 'High'</value>
    </values>
    <values>
        <field>QueryResultHandling__c</field>
        <value xsi:type="xsd:string">ONE_RESULT</value>
    </values>
    <values>
        <field>ComparisonOperator__c</field>
        <value xsi:type="xsd:string">EQUALS</value>
    </values>
    <values>
        <field>ExpectedValueSource__c</field>
        <value xsi:type="xsd:string">FIXED_VALUE</value>
    </values>
    <values>
        <field>ExpectedFixedValue__c</field>
        <value xsi:type="xsd:string">0</value>
    </values>
    <values>
        <field>DisplayFoundText__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcResult.foundValue} open high-priority cases</value>
    </values>
    <values>
        <field>DisplayExpectedText__c</field>
        <value
      xsi:type="xsd:string"
    >No open high-priority cases for {!record.Name fallback="this account"}</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This account"} has {!rhcResult.foundValue} open high-priority case record(s) requiring immediate attention.</value>
    </values>
    <values>
        <field>UnableToEvaluateMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!rhcRule.checkTitle} could not run for {!record.Name fallback="this account"}. Verify Case access and retry.</value>
    </values>
    <values>
        <field>ActionLabel__c</field>
        <value
      xsi:type="xsd:string"
    >Coordinate {!record.Name fallback="account"} case recovery</value>
    </values>
    <values>
        <field>ActionUrl__c</field>
        <value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/related/Cases/view</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Confirm ownership, document a recovery plan, and resolve or appropriately reprioritize each issue for {!record.Name fallback="this account"}.</value>
    </values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">ALL_RECORDS</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">60</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
</CustomMetadata>
