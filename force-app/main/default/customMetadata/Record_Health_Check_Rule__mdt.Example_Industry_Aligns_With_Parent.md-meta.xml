<?xml version='1.0' encoding='UTF-8' ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example_Industry Aligns With Parent</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Relationship_Risk</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Industry aligns with parent account</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Checks industry alignment across the account hierarchy for consistent segmentation and reporting.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">COMPLETENESS</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value
      xsi:type="xsd:string"
    >TEXT(Industry) = TEXT(Parent.Industry)</value>
    </values>
    <values><field>DisplayFoundFormula__c</field><value
      xsi:type="xsd:string"
    >IF(ISBLANK(TEXT(Industry)), "Not classified", TEXT(Industry))</value></values>
    <values><field>DisplayExpectedFormula__c</field><value
      xsi:type="xsd:string"
    >IF(ISBLANK(TEXT(Parent.Industry)), "Parent not classified", TEXT(Parent.Industry))</value></values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">INFO</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This account"}'s industry differs from its parent account.</value>
    </values>
    <values><field>FixMessage__c</field><value
      xsi:type="xsd:string"
    >Confirm the correct classification, then align {!record.Name fallback="the account"} with its parent or document the exception.</value></values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Align {!record.Name fallback="account"} with its parent</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/Account/{!record.Id}/edit</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >{!rhcRule.checkTitle} could not compare {!record.Name fallback="this account"} with its parent. Verify access to both Industry fields and retry.</value></values>
    <values><field>ApplicabilityNotMetMessage__c</field><value
      xsi:type="xsd:string"
    >{!record.Name fallback="This account"} has no parent account, so hierarchy alignment does not apply.</value></values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">WHEN_FORMULA_TRUE</value>
    </values>
    <values>
        <field>ApplicabilityFormula__c</field>
        <value xsi:type="xsd:string">NOT(ISBLANK(ParentId))</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">25</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
</CustomMetadata>
