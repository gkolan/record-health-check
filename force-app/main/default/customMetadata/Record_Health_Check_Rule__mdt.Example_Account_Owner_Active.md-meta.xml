<?xml version='1.0' encoding='UTF-8' ?>
<CustomMetadata
  xmlns="http://soap.sforce.com/2006/04/metadata"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
>
    <label>Example_Account Owner Is Active</label>
    <protected>false</protected>
    <values>
        <field>Record_Health_Check_Set__c</field>
        <value xsi:type="xsd:string">Example_Account_Relationship_Risk</value>
    </values>
    <values>
        <field>CheckTitle__c</field>
        <value xsi:type="xsd:string">Account owner is active</value>
    </values>
    <values>
        <field>CheckDescription__c</field>
        <value
      xsi:type="xsd:string"
    >Confirms that the account is assigned to an active user who can own follow-up and customer commitments.</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">COMPLETENESS</value>
    </values>
    <values>
        <field>EvaluationType__c</field>
        <value xsi:type="xsd:string">FORMULA</value>
    </values>
    <values>
        <field>PassConditionFormula__c</field>
        <value xsi:type="xsd:string">Owner.IsActive</value>
    </values>
    <values>
        <field>DisplayFoundFormula__c</field>
        <value
      xsi:type="xsd:string"
    >TRIM(Owner.FirstName &amp; " " &amp; Owner.LastName) &amp; " is " &amp; IF(Owner.IsActive, "active", "inactive")</value>
    </values>
    <values>
        <field>DisplayExpectedFormula__c</field>
        <value xsi:type="xsd:string">"Account owner should be active"</value>
    </values>
    <values>
        <field>FailureSeverity__c</field>
        <value xsi:type="xsd:string">CRITICAL</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value
      xsi:type="xsd:string"
    >{!record.Name fallback="This account"} is assigned to {!record.Owner.Name fallback="an inactive user"}, so customer commitments no longer have an active owner.</value>
    </values>
    <values>
        <field>FixMessage__c</field>
        <value
      xsi:type="xsd:string"
    >Contact {!record.Owner.Manager.Name fallback="your Salesforce administrator"} to confirm the replacement owner, preserve open commitments, and reassign {!record.Name fallback="the account"}.</value>
    </values>
    <values><field>ActionLabel__c</field><value
      xsi:type="xsd:string"
    >Open {!record.Owner.Name fallback="inactive owner"}</value></values>
    <values><field>ActionUrl__c</field><value
      xsi:type="xsd:string"
    >/lightning/r/User/{!record.OwnerId}/view</value></values>
    <values><field>UnableToEvaluateMessage__c</field><value
      xsi:type="xsd:string"
    >{!rhcRule.checkTitle} could not evaluate the owner of {!record.Name fallback="this account"}. Verify access to the Account owner and User status, then retry.</value></values>
    <values>
        <field>ApplicabilityMode__c</field>
        <value xsi:type="xsd:string">ALL_RECORDS</value>
    </values>
    <values>
        <field>EvaluationOrder__c</field>
        <value xsi:type="xsd:double">20</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
</CustomMetadata>
