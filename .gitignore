# This file is used for Git repositories to specify intentionally untracked files that Git should ignore. 
# If you are not using git, you can delete this file. For more information see: https://git-scm.com/docs/gitignore
# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json
/config/*
# Published install / subscriber setup inputs (scratch defs live under the package).
!/config/package-releases.json
!/config/subscriber-scratch-def.json
!/config/quality-metrics.json
!/config/toolchain.json
!/config/release-runtime-matrix.json
!/config/apex-test-overlays.json
!/config/code-analyzer-inline-suppressions.json
!/config/locker-scratch-def.json
!/config/lws-scratch-def.json
.claude/
.playwright-mcp/

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/
dist/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Generated and local-only reports
/reports/
releases/**/reports/tmp/
test-results/
playwright-report/
*.junit.xml
*.tap

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
.env.*
!.env.example

# Maintainer-only material — never committed or published with the project.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.github/copilot-instructions.md
/.github/SALESFORCE_OPERATIONS.md
/internal/
/spec/
# Local-only design and customer specs must never be published with the repository.
/specs/
/evidence/
/releases/
packages/record-health-check/.package-artifacts/
packages/record-health-check/.package-evidence/
.backups/
tasks/
slides_build/
*.pptx
project-homepage.html
project-homepage copy.html
PUBLISHING.md

# Stray screenshots / build images (not referenced by docs)
build-record-health-check-mobile.png

# CI / IDE artifacts
/code-analyzer/
.cursor/
.vscode/
*.tgz

# Doc-template scaffolding / boilerplate — not published with the project.
# (Note: .github/ISSUE_TEMPLATE/ and pull_request_template.md are functional
#  GitHub config and are intentionally NOT ignored.)
templates/
**/_TEMPLATE.*

# Maintainer doc-generation / authoring tooling (one-off Python scripts).
# Local helper scripts — kept local, not published with the project.
scripts/*
# Release-gate scripts used by package.json and CI are public and tracked.
!scripts/release/
!scripts/release/**
# Shared path helpers for subscriber / contributor / package commands.
!scripts/lib/
!scripts/lib/**
# Isolated, explicitly invoked review fixtures that must never enter package source.
!scripts/review/
!scripts/review/**
# Subscriber scratch-org install / upgrade / smoke (npm run subscriber:*).
!scripts/subscriber/
!scripts/subscriber/**
# Contributor source-development scratch orgs (npm run dev:*).
!scripts/contributor/
!scripts/contributor/**
# Package-scoped Jest runner (npm run test:unit*).
!scripts/run-package-jest.mjs
# Public Apex plugin scaffolding shipped as the 2.0 migration path.
!scripts/templates/
!scripts/templates/**
# Reproducible demo scratch-org provisioning (see docs/installation/create-rhc-scratch-org.md).
!scripts/setup-demo.sh
# Reproducible multi-currency integration-demo provisioning.
!scripts/setup-integration-demo.sh
# Display: Value Format coverage org (see docs/reference/reference-display-value-format.md).
!scripts/setup-display-formats.sh
# Exception: the metadata validator is a release-gate dependency referenced by
# .github/workflows/salesforce-validate.yml and the upgrade guide, so it must
# be tracked. Everything else under scripts/ stays local.
!scripts/apex/
scripts/apex/*
!scripts/apex/validateMetadata.apex
!scripts/apex/setupDemoData.apex
!scripts/apex/setupDemoUser.apex
!scripts/apex/deactivateDemoUser.apex
!scripts/apex/verifyDemo.apex
!scripts/apex/setupDisplayFormatData.apex
!scripts/apex/verifyDisplayFormats.apex
!scripts/demo/
!scripts/demo/**
!scripts/display-formats/
!scripts/display-formats/**

# Point-in-time maintainer audit / review write-ups at repo root (keep under tasks/).
/*-AUDIT-*.md
/AUDIT-*.md
/CODE-REVIEW-*.md
/DOCUMENTATION-AUDIT-*.md
/FIX-VERIFICATION-*.md

# Internal bug write-ups — kept local, not published with the project.
bugs/

# Internal documentation-gap audits — kept local after the public docs are updated.
doc-gaps/

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Local recycle bin — superseded material kept on disk but never tracked
recycle-bin/

# Legacy GitHub Wiki source; public guidance is maintained under docs/.
/wiki/

# Personal, portable local org kit — never tracked; meant to be movable out of the repo.
/local-orgs/
