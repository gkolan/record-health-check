---
import { LinkButton } from '@astrojs/starlight/components';
import { LICENSE_URL } from '../lib/site-links.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const imageHtml = image && 'html' in image ? image.html : undefined;
---

<div class="hero">
  <div class="hero-copy">
    <a class="license" href={LICENSE_URL}>Open Source <span aria-hidden="true">·</span> Apache 2.0</a>

    <div class="headline">
      <h1 id="_top" data-page-title set:html={title} />
      {tagline && <p class="tagline" set:html={tagline} />}
    </div>

    <div class="outcomes" aria-label="Guidance shown to users">
      <div class="outcome">
        <strong>Confirm</strong>
        <span>What looks good</span>
      </div>
      <div class="outcome">
        <strong>Focus</strong>
        <span>What needs attention</span>
      </div>
      <div class="outcome">
        <strong>Act</strong>
        <span>What to do next</span>
      </div>
    </div>

    <div class="actions">
      {
        actions.map(({ link: href, text, variant }) => (
          <LinkButton {href} {variant}>{text}</LinkButton>
        ))
      }
    </div>
  </div>

  {imageHtml && <div class="product-preview" set:html={imageHtml} />}
</div>

<style>
  @layer starlight.core {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 6fr) minmax(18rem, 4fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
      padding-block: clamp(3rem, 7vw, 5.5rem);
    }

    .hero-copy,
    .headline {
      display: flex;
      flex-direction: column;
    }

    .hero-copy {
      gap: 1.35rem;
      align-items: flex-start;
    }

    .headline {
      gap: 0.85rem;
    }

    .license {
      border-radius: 999px;
      padding: 0.35rem 0.7rem;
      background: var(--sl-color-gray-6);
      color: var(--sl-color-text-accent);
      font-size: var(--sl-text-xs);
      font-weight: 600;
      line-height: 1;
      text-decoration: none;
    }

    h1 {
      max-width: 16ch;
      color: var(--sl-color-white);
      font-size: clamp(var(--sl-text-4xl), calc(1.4rem + 3vw), var(--sl-text-6xl));
      font-weight: 650;
      line-height: 1.05;
    }

    .tagline {
      max-width: 49rem;
      color: var(--sl-color-gray-2);
      font-size: clamp(var(--sl-text-base), calc(0.9rem + 0.45vw), var(--sl-text-xl));
      line-height: 1.55;
    }

    .outcomes {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
      width: 100%;
      max-width: 42rem;
    }

    .outcome {
      display: grid;
      gap: 0.15rem;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
    }

    .outcome strong {
      color: var(--sl-color-white);
      font-size: var(--sl-text-sm);
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .actions :global(a) {
      justify-content: center;
    }

    .product-preview {
      position: relative;
      height: clamp(24rem, 42vw, 31rem);
      overflow: hidden;
      border-radius: 0.75rem;
      background: white;
      box-shadow: var(--sl-shadow-lg);
    }

    .product-preview::after {
      content: '';
      position: absolute;
      inset: auto 0 0;
      height: 4rem;
      background: linear-gradient(transparent, rgb(255 255 255 / 92%));
      pointer-events: none;
    }

    .product-preview :global(img) {
      display: block;
      width: 100%;
      height: auto;
    }

    @media (max-width: 49.99rem) {
      .hero {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .hero-copy {
        align-items: center;
      }

      .outcomes {
        text-align: start;
      }
    }

    @media (max-width: 29.99rem) {
      .outcomes {
        grid-template-columns: 1fr;
      }

      .actions {
        justify-content: center;
      }
    }
  }

  @layer starlight.components {
    .actions :global(.sl-link-button) {
      min-height: 2.75rem;
      border-radius: 0.5rem;
      padding: 0.7rem 1.2rem;
    }

    .actions :global(.sl-link-button.secondary) {
      border: 0;
      background: var(--sl-color-gray-6);
      color: var(--sl-color-white);
    }

    .actions :global(.sl-link-button.secondary:hover) {
      background: var(--sl-color-gray-5);
    }
  }
</style>
