{
  "name": "record-health-check",
  "private": true,
  "version": "2.0.0",
  "description": "Metadata-driven, extensible record health checks for Salesforce",
  "license": "Apache-2.0",
  "author": "Gautam Kolan (https://github.com/gkolan)",
  "homepage": "https://github.com/gkolan/record-health-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkolan/record-health-check.git"
  },
  "bugs": {
    "url": "https://github.com/gkolan/record-health-check/issues"
  },
  "scripts": {
    "lint": "eslint --no-error-on-unmatched-pattern **/{aura,lwc}/**/*.js",
    "lint:slds": "node scripts/release/check_slds.mjs",
    "check:namespaced-tokens": "python3 scripts/release/check_namespaced_tokens.py check",
    "check:configuration-identity": "node scripts/release/check_configuration_identity.mjs",
    "check:test-data-factory": "node scripts/release/check_test_data_factory.mjs",
    "check:apex-architecture": "node scripts/release/check_apex_architecture.mjs",
    "check:apex-surface": "node scripts/release/check_apex_surface.mjs",
    "check:code-analyzer-output-paths": "node scripts/release/check_code_analyzer_output_paths.mjs",
    "check:product-version-language": "node scripts/release/check_product_version_language.mjs",
    "check:docs": "node scripts/release/check_docs.mjs && node scripts/release/audit_docs_quality.mjs --check",
    "check:field-limits": "python3 scripts/release/generate_field_size_registry.py --check",
    "check:manifest": "node scripts/release/check_manifest_coverage.mjs",
    "check:package-boundary": "node scripts/release/check_package_boundary.mjs",
    "check:query-shapes": "python3 scripts/release/inventory_bulk_query_shapes.py --self-test && python3 scripts/release/inventory_bulk_query_shapes.py --check",
    "capture:query-verdicts": "python3 scripts/release/capture_query_verdicts.py",
    "check:query-verdicts": "python3 scripts/release/capture_query_verdicts.py --refresh-results --compare-to scripts/release/generated/query-verdict-baseline.json",
    "check:permission-sets": "node scripts/release/check_permission_sets.mjs",
    "check:plugin-sharing": "node scripts/release/check_plugin_sharing.mjs --self-test && node scripts/release/check_plugin_sharing.mjs",
    "check:apex-coverage": "node scripts/release/check_apex_coverage.mjs",
    "fix:apex-braces": "node scripts/release/add_apex_braces.mjs",
    "audit:docs": "node scripts/release/audit_docs_quality.mjs",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:watch": "sfdx-lwc-jest --watch",
    "test:unit:debug": "sfdx-lwc-jest --debug",
    "test:unit:coverage": "sfdx-lwc-jest --coverage -- --no-cache",
    "prettier": "prettier --write --no-error-on-unmatched-pattern \"force-app/**/*.{cls,css,html,js,trigger,xml}\" \"integration-tests/**/*.{cls,css,html,js,trigger,xml}\" \"scripts/**/*.{apex,js,json,md,mjs,xml,yaml,yml}\" \"manifest/**/*.xml\" \"config/**/*.json\" \"*.{js,json,md,xml,yaml,yml}\" \".github/**/*.{md,yaml,yml}\"",
    "prettier:verify": "prettier --check --no-error-on-unmatched-pattern \"force-app/**/*.{cls,css,html,js,trigger,xml}\" \"integration-tests/**/*.{cls,css,html,js,trigger,xml}\" \"scripts/**/*.{apex,js,json,md,mjs,xml,yaml,yml}\" \"manifest/**/*.xml\" \"config/**/*.json\" \"*.{js,json,md,xml,yaml,yml}\" \".github/**/*.{md,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce-ux/slds-linter": "^1.2.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "sfdx-lwc-jest -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
