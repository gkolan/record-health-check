{
  "name": "record-health-check",
  "private": true,
  "version": "2.0.7",
  "description": "Metadata-driven, extensible record health checks for Salesforce",
  "license": "Apache-2.0",
  "author": "Gautam Kolan (https://github.com/gkolan)",
  "homepage": "https://github.com/gkolan/record-health-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkolan/record-health-check.git"
  },
  "bugs": {
    "url": "https://github.com/gkolan/record-health-check/issues"
  },
  "scripts": {
    "presetup": "npm run check:toolchain",
    "setup": "node scripts/subscriber/setup.mjs",
    "presubscriber:setup": "npm run check:toolchain",
    "subscriber:setup": "node scripts/subscriber/setup.mjs",
    "presubscriber:test": "npm run check:toolchain",
    "subscriber:test": "node scripts/subscriber/test.mjs",
    "presubscriber:upgrade": "npm run check:toolchain",
    "subscriber:upgrade": "node scripts/subscriber/upgrade.mjs",
    "predev:setup": "npm run check:toolchain",
    "dev:setup": "node scripts/contributor/setup.mjs",
    "predev:test": "npm run check:toolchain",
    "dev:test": "node scripts/contributor/test.mjs",
    "test:war-room": "node scripts/contributor/war-room.mjs",
    "generate:agentforce-testing-center": "node scripts/contributor/generate-agentforce-testing-center.mjs",
    "predev:test-no-namespace": "npm run check:toolchain",
    "dev:test-no-namespace": "node scripts/contributor/test-no-namespace.mjs",
    "demo:setup-source": "node scripts/contributor/setup-demo.mjs",
    "release:preflight": "node scripts/release/run_release_preflight.mjs",
    "prepackage:create": "npm run check:toolchain",
    "package:create": "node scripts/release/create-package-version.mjs",
    "prepackage:verify": "npm run check:toolchain",
    "package:verify": "node scripts/release/verify-package-version.mjs",
    "prepackage:promote": "npm run release:preflight",
    "package:promote": "node scripts/release/promote-package-version.mjs",
    "check:toolchain": "node scripts/release/check_toolchain.mjs",
    "check:toolchain-latest": "node scripts/release/check_toolchain.mjs --policy-only --latest",
    "check:toolchain-policy": "node scripts/release/check_toolchain.mjs --policy-only",
    "check:scratch-capacity": "node scripts/release/check_scratch_capacity.mjs",
    "lint": "eslint --no-error-on-unmatched-pattern **/{aura,lwc}/**/*.js",
    "lint:slds": "node scripts/release/check_slds.mjs",
    "check:namespaced-tokens": "python3 scripts/release/check_namespaced_tokens.py check",
    "check:configuration-identity": "node scripts/release/check_configuration_identity.mjs",
    "check:lightning-runtime-compatibility": "node scripts/release/check_lightning_runtime_compatibility.mjs --self-test",
    "check:agent-tool-contract": "node scripts/release/check_agent_tool_contract.mjs",
    "check:mcp": "npm run check --prefix packages/record-health-check-mcp",
    "check:test-data-factory": "node scripts/release/check_test_data_factory.mjs",
    "generate:test-data-factory-inventory": "node scripts/release/generate_test_data_factory_inventory.mjs",
    "check:test-data-factory-inventory": "node scripts/release/generate_test_data_factory_inventory.mjs --check",
    "check:apex-architecture": "node scripts/release/check_apex_architecture.mjs",
    "check:apex-surface": "node scripts/release/check_apex_surface.mjs",
    "check:code-analyzer-output-paths": "node scripts/release/check_code_analyzer_output_paths.mjs",
    "check:code-analyzer-suppressions": "node scripts/release/check_code_analyzer_suppressions.mjs",
    "generate:code-analyzer-inline-suppressions": "node scripts/release/generate_code_analyzer_inline_suppressions.mjs --write",
    "check:code-analyzer-inline-suppressions": "node scripts/release/generate_code_analyzer_inline_suppressions.mjs",
    "check:version-sync": "node scripts/release/check_version_sync.mjs",
    "check:product-version-language": "node scripts/release/check_product_version_language.mjs",
    "check:distribution-boundary": "node scripts/release/check_distribution_boundary.mjs",
    "check:docs": "node scripts/release/check_docs.mjs && node scripts/release/audit_docs_quality.mjs --check",
    "check:field-limits": "python3 scripts/release/generate_field_size_registry.py --check",
    "check:manifest": "node scripts/release/check_manifest_coverage.mjs",
    "check:package-artifact": "node scripts/release/audit_package_artifact.mjs",
    "check:package-boundary": "node scripts/release/check_package_boundary.mjs",
    "check:query-shapes": "python3 scripts/release/inventory_bulk_query_shapes.py --self-test && python3 scripts/release/inventory_bulk_query_shapes.py --check",
    "capture:query-verdicts": "python3 scripts/release/capture_query_verdicts.py",
    "check:query-verdicts": "python3 scripts/release/capture_query_verdicts.py --refresh-results --compare-to scripts/release/generated/query-verdict-baseline.json",
    "check:permission-sets": "node scripts/release/check_permission_sets.mjs",
    "check:plugin-sharing": "node scripts/release/check_plugin_sharing.mjs --self-test && node scripts/release/check_plugin_sharing.mjs",
    "check:apex-coverage": "node scripts/release/check_apex_coverage.mjs",
    "test:apex:exact": "node scripts/release/run_exact_apex_test_inventory.mjs",
    "check:quality-metrics": "node scripts/release/check_quality_metrics.mjs",
    "check:hosted-validation": "node scripts/release/check_hosted_validation.mjs",
    "check:hosted-validation:self-test": "node scripts/release/check_hosted_validation.mjs --self-test",
    "check:release-gate-parity": "node scripts/release/check_release_gate_parity.mjs",
    "check:release-runtime-matrix": "node scripts/release/check_release_runtime_matrix.mjs",
    "check:dependency-security": "npm audit --omit=dev --audit-level=low && npm audit --audit-level=moderate",
    "check:xml": "python3 -c \"import pathlib,xml.etree.ElementTree as ET; [ET.parse(p) for root in ('packages/record-health-check/force-app','packages/record-health-check/integration-tests','packages/record-health-check/manifest','subscriber-app') for p in pathlib.Path(root).rglob('*.xml')]\"",
    "fix:apex-braces": "node scripts/release/add_apex_braces.mjs",
    "audit:docs": "node scripts/release/audit_docs_quality.mjs",
    "test": "npm run test:unit",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "test:unit": "node scripts/run-package-jest.mjs",
    "test:unit:watch": "node scripts/run-package-jest.mjs --watch",
    "test:unit:debug": "node scripts/run-package-jest.mjs --debug",
    "test:unit:coverage": "node scripts/run-package-jest.mjs --coverage -- --no-cache",
    "test:browser": "playwright test",
    "test:browser:salesforce": "node scripts/release/run_salesforce_browser_gate.mjs",
    "prettier": "prettier --write --no-error-on-unmatched-pattern \"packages/record-health-check/force-app/**/*.{cls,css,html,js,trigger,xml}\" \"packages/record-health-check/integration-tests/**/*.{cls,css,html,js,trigger,xml}\" \"subscriber-app/**/*.{cls,css,html,js,trigger,xml}\" \"scripts/**/*.{apex,js,json,md,mjs,xml,yaml,yml}\" \"packages/record-health-check/manifest/**/*.xml\" \"config/**/*.json\" \"*.{js,json,md,xml,yaml,yml}\" \".github/**/*.{md,yaml,yml}\"",
    "prettier:verify": "prettier --check --no-error-on-unmatched-pattern \"packages/record-health-check/force-app/**/*.{cls,css,html,js,trigger,xml}\" \"packages/record-health-check/integration-tests/**/*.{cls,css,html,js,trigger,xml}\" \"subscriber-app/**/*.{cls,css,html,js,trigger,xml}\" \"scripts/**/*.{apex,js,json,md,mjs,xml,yaml,yml}\" \"packages/record-health-check/manifest/**/*.xml\" \"config/**/*.json\" \"*.{js,json,md,xml,yaml,yml}\" \".github/**/*.{md,yaml,yml}\"",
    "prepare": "husky || true",
    "precommit": "lint-staged"
  },
  "devDependencies": {
    "@locker/eslint-config-locker": "^0.28.9",
    "@lwc/eslint-plugin-lwc": "^3.1.0",
    "@playwright/test": "^1.62.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce-ux/slds-linter": "^1.2.1",
    "@salesforce/eslint-config-lwc": "^4.0.0",
    "@salesforce/eslint-plugin-aura": "^3.0.0",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.2",
    "ajv": "^8.20.0",
    "eslint": "^9.29.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "prettier-plugin-apex": "^2.2.6"
  },
  "overrides": {
    "@babel/core": "7.29.7"
  },
  "lint-staged": {
    "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
      "prettier --write"
    ],
    "**/{aura,lwc}/**/*.js": [
      "eslint"
    ],
    "**/lwc/**": [
      "node scripts/run-package-jest.mjs -- --bail --findRelatedTests --passWithNoTests"
    ]
  }
}
